{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sancho-chat",
  // Preserve dashboard variables; explicitly declared vars below update the model configuration.
  "keep_vars": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Bundle the prompt + knowledge markdown as text modules
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Per-IP rate limit: 12 requests / 60s
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 12, "period": 60 }
      }
    ]
  },
  // USAGE: daily message counter. LEADS: recruiter leads from the contact card.
  "kv_namespaces": [
    { "binding": "USAGE", "id": "f06994e5823e456da029d653cce23b85" },
    { "binding": "LEADS", "id": "cfc83004ff8945839e153dd37028eec7" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://esteban-sanchez-ortiz.github.io,http://localhost:5173,http://localhost:5175",
    "CHAT_PROVIDER": "fireworks",
    "FIREWORKS_MODEL": "accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GROQ_FALLBACK_MODEL": "openai/gpt-oss-20b",
    "GUARD_MODEL": "meta-llama/llama-prompt-guard-2-86m",
    "DAILY_MESSAGE_CAP": "1500"
  }
  // Secrets (wrangler secret put): FIREWORKS_API_KEY, GROQ_API_KEY, CANARY
}
