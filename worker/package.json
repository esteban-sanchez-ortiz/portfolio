{
  "name": "sancho-chat-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "dev:local": "wrangler dev --local --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787 --persist-to ../.local-worker-state"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "wrangler": "4.115.0"
  }
}
